# 复制为 .env 并按需修改
# 数据库（默认 SQLite，文件落在 backend/ 目录）
DATABASE_URL=sqlite:///./zhigeng.db

# AI 结构化提取（OpenAI 兼容接口；不配置则自动使用规则降级提取）
AI_API_KEY=
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus

# 采集礼貌间隔（秒），单来源内相邻请求的最小间隔
CRAWL_DELAY_SECONDS=1.0
# 单页抓取超时（秒）
CRAWL_TIMEOUT=20
